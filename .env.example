# ===== Obsidian Agent 配置模板 =====
# 复制为 .env 后按需修改（Docker 部署时由 docker-compose 读取）

# ---- 核心 ----
# 容器内路径（一般不用改）；宿主机路径用下面两个 HOST_PATH（Windows 请用正斜杠 C:/Users/...）
VAULT_PATH=/vault
DATA_DIR=/data
VAULT_HOST_PATH=C:/Users/你的用户名/Documents/知识库
DATA_HOST_PATH=C:/Users/你的用户名/Documents/知识库数据
PORT=8080
INDEX_BACKEND=fts5             # fts5（默认，零依赖）| meili（需 meilisearch 容器）
# MEILI_URL=http://meilisearch:7700
# MEILI_MASTER_KEY=

# ---- LLM（Agent 必配；不启用 Agent 可留空）----
LLM_PROVIDER=deepseek          # deepseek | openai | kimiapi | ollama | custom
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=                  # 留空按 provider 默认
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# OLLAMA_HOST=http://host.docker.internal:11434

# ---- Vault 行为 ----
IGNORE_DIRS=.obsidian,.trash,.git,node_modules,.stfolder
IGNORE_FILES=
MAX_FILE_BYTES=5242880         # 5MB
WATCH_ENABLED=true
WATCH_DEBOUNCE_SECONDS=2
WATCH_POLLING=false           # Windows bind mount 收不到事件时设 true（轮询兜底）

# ---- 安全 ----
AUTH_TOKEN=                    # 必填（除本地开发）：登录口令；为空则 Web 服务 503 拒绝启动
AUTH_DISABLED=false            # 仅本地开发/测试可设 true；生产保持 false
COOKIE_SECURE=false            # 走 HTTPS（含 Caddy internal TLS）时设 true，Cookie 只走加密通道
CORS_ORIGINS=                  # 留空 = 同源部署；跨源时填逗号分隔来源
ENABLE_LOCAL_SETTINGS=false    # 生产保持 false；true 才暴露目录浏览/切换 vault
MCP_TOKEN=                     # MCP 服务独立口令；为空则 MCP 拒绝启动
DISALLOWED_WRITE_DIRS=.obsidian,.trash,.git

# ---- 备份 ----
BACKUP_ENABLED=true
# 备份根目录：必须位于 vault 之外。Docker 部署务必指向挂载盘（如 /data/backups），
# 否则默认落在容器内 {项目根}/backups，重建容器即丢失
BACKUP_DIR=/data/backups
BACKUP_SCHEDULE=0 2 * * *      # 定时整库快照 cron（已废弃，改为前端活跃式自动备份；空 = 仅手动）
BACKUP_RETENTION=7d,4w,3m      # 保留策略：每日7份 / 每周4份 / 每月3份
BACKUP_MAX_BYTES=10485760      # 快照跳过 10MB 以上文件
BACKUP_VERIFY=true
AUTO_BACKUP_ENABLED=true       # 活跃式自动备份开关
AUTO_BACKUP_INTERVAL_MINUTES=30  # 活跃式自动备份间隔（1~1440）

# ---- 语义检索（可选）----
# 需要先安装：pip install ".[semantic]"（fastembed + ONNX，不装则自动降级为关键词检索）
SEMANTIC_ENABLED=false
SEMANTIC_MODEL=BAAI/bge-small-zh-v1.5   # 中文小模型，CPU 上 634 篇约 20s 建完
SEMANTIC_CACHE_DIR=                      # 空 = {DATA_DIR}/models（模型约 100MB，随数据卷持久化）
SEMANTIC_WEIGHT=1.5                      # 语义通道权重（>1 时自然语言提问优先语义排序）
# 国内下载模型慢可设镜像：HF_ENDPOINT=https://hf-mirror.com

# ---- 索引性能 ----
INDEX_BATCH_SIZE=200
INDEX_WORKERS=2
JIEBA_USERDICT=             # jieba 自定义词典（如 ./data/userdict.txt，每行一个词）
